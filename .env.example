# Bu dosya ".env" adıyla kopyalanır ve değerler doldurulur.

# --- Claude (rapor) ---
ANTHROPIC_API_KEY=sk-ant-buraya-yapistir
ANTHROPIC_MODEL=claude-sonnet-5

# --- Telegram botu (n8n akışı kullanır) ---
TELEGRAM_BOT_TOKEN=BotFather-in-verdigi-token

# --- Model servisi ---
INFERENCE_URL=http://localhost:8000
MODEL_PATH=./model/model.keras
CLASS_NAMES_PATH=./model/class_names.json
MODEL_META_PATH=./model/model_meta.json
# Model karşılaştırması (isteğe bağlı): üç modelin .keras dosyaları bu klasörde yoksa
# servis çalışmaya devam eder, yalnızca karşılaştırma uç noktası devre dışı kalır.
TUBITAK_MODEL_DIR=./model/tubitak

# --- Kayıt veritabanı ---
DB_PATH=./bot/tarla_defteri.sqlite

# --- Karar eşiği: güven bu değerin altındaysa kullanıcı uzmana yönlendirilir ---
CONFIDENCE_THRESHOLD=0.70

# --- Hava durumu: Open-Meteo ücretsizdir, anahtar gerekmez ---

# --- Otomatik bitki tanıma (isteğe bağlı, Pl@ntNet ücretsiz plan) ---
# Boş bırakılırsa bitki yalnızca Telegram fotoğraf açıklamasından okunur.
PLANTNET_API_KEY=
PLANTNET_MIN_SKOR=0.20
